PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/tuitiontrack?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173,https://tuition-track.vercel.app

# Free manual reminder queue.
# The app prepares WhatsApp messages. Teacher manually clicks Send in WhatsApp.
UPCOMING_REMINDER_DAYS=3

# Web push notifications for subscribed teacher devices
VAPID_PUBLIC_KEY=replace_with_generated_public_key
VAPID_PRIVATE_KEY=replace_with_generated_private_key
VAPID_SUBJECT=mailto:admin@your-domain.com
